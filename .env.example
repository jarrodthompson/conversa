# ─────────────────────────────────────────────────────────────────────────────
# Conversa — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only secrets) ───────────────────────────────────────────
# Service-role key. SERVER ONLY. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for running migrations & seeds locally.
# e.g. postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Conversa

# ── AI provider (optional) ───────────────────────────────────────────────────
# Leave AI_PROVIDER unset (or any non-'anthropic' value) for deterministic,
# clearly-labelled drafts. Set AI_PROVIDER=anthropic + an ANTHROPIC_API_KEY to
# generate real AI reply drafts. AI_MODEL is optional (default claude-opus-5);
# set claude-haiku-4-5 or claude-sonnet-5 for cheaper/faster drafts.
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-opus-5

# ── Channel providers (optional; mock adapters used when blank) ───────────────
# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Email (Resend or compatible)
RESEND_API_KEY=
EMAIL_FROM=
# Meta Messenger / Instagram
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Scheduled automation sweep (/api/cron/sweep) — required for time-based rules
CRON_SECRET=

# ── Billing (Peach Payments, optional) ────────────────────────────────────────
# Without these, plan switching updates the DB only (no payment). With them, plan
# buttons open Peach Hosted Checkout (V2) and the webhook activates the plan.
# Set plan prices in ZAR via subscription_plans.price_monthly (minor units) +
# currency='ZAR'. Webhook endpoint: https://<domain>/api/webhooks/peach
# PEACH_MODE=sandbox (default) or live.
PEACH_MODE=sandbox
PEACH_CLIENT_ID=
PEACH_CLIENT_SECRET=
PEACH_MERCHANT_ID=
PEACH_ENTITY_ID=
PEACH_WEBHOOK_SECRET=
