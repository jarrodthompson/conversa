# ─────────────────────────────────────────────────────────────────────────────
# Conversa — environment variables
# Copy to .env.local and fill in. Never commit .env.local.
# ─────────────────────────────────────────────────────────────────────────────

# ── Supabase (public) ────────────────────────────────────────────────────────
# Project URL, e.g. https://xxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_URL=
# Publishable / anon key (safe to expose to the browser).
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ── Supabase (server-only secrets) ───────────────────────────────────────────
# Service-role key. SERVER ONLY. Bypasses RLS — never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=
# Direct Postgres connection string for running migrations & seeds locally.
# e.g. postgresql://postgres:PASSWORD@db.xxxx.supabase.co:5432/postgres
SUPABASE_DB_URL=

# ── App ──────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME=Conversa

# ── AI provider (optional) ───────────────────────────────────────────────────
# Leave AI_PROVIDER=demo for the deterministic, clearly-labelled demo mode.
# Set to 'anthropic' and provide a key to enable a live provider.
AI_PROVIDER=demo
ANTHROPIC_API_KEY=
AI_MODEL=claude-sonnet-5

# ── Channel providers (optional; mock adapters used when blank) ───────────────
# WhatsApp Business Cloud API (Meta)
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=
# Email (Resend or compatible)
RESEND_API_KEY=
EMAIL_FROM=
# Meta Messenger / Instagram
META_APP_SECRET=
META_PAGE_ACCESS_TOKEN=

# Scheduled automation sweep (/api/cron/sweep) — required for time-based rules
CRON_SECRET=
